    "x-next-cache-tags": "_N_T_/layout,_N_T_/user/layout,_N_T_/user/history/layout,_N_T_/user/history/page,_N_T_/user/history"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/user/history/__PAGE__",
    "/user/history",
    "/user",
    "/_index",
    "/_head"
  ]
}