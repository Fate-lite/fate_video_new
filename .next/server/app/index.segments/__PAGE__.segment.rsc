6:["$","$L9",null,{"title":"热播动漫","keyName":"dongman","videos":[{"id":"2ad86f0464f9047357edb69e5e1eac82","title":"钟馗","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260630-1/3ed82e9627025409c5ad598a2f38b5b3.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"段艺璇 / 余昊威 / 胡良伟 / 赵成晨 / 巴赫 / 胡正健 / 露西","director":"王羽熙 / 黄山川","des":"<p>　钟馗世代在暗中守护人妖两界安宁。一次追捕妖怪时，他救下人间少女初九，带她到地府疗伤。在这里，初九遇见了一群特别的朋友：神界顶流通灵耳、温柔的孟娘，还有憨萌可爱的牛头马面。一段充满奇趣的地府冒险就此展开。</p><p>　　初九聪明又大胆，看到钟馗守护百姓的模样，下定决心要拜他为师。钟馗起初不肯，却在与她并肩捉妖的过程中，渐渐看到她的真心与天赋。然而这次的妖怪并不简单，在异常强大的战力背后，一场足以颠覆人间与地府的巨大危机，悄然降临……</p><p><br/></p>","last":"2026-06-30 19:46:24","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260630/LJ9jVisP/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/share/91fd7b300a09c5d358306361b2ea17b3"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/20260701/12287_05e38f85/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.yzzy28-play.com/20260630/32015_f2a5e399/index.m3u8"}]},{"sourceName":"动漫发布 (jinyingm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"jinyingm3u8","links":[{"name":"正片","url":"https://hd.ijycnd.com/play/dR6l3q0d/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v12.ppqrrs.com/wjv12/202606/30/CQJj20iLHm96/video/index.m3u8"}]},{"sourceName":"动漫发布 (hnm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/aOYg3nGd/index.m3u8"}]},{"sourceName":"动漫发布 (ffm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://vip.ffzy-plays.com/20260630/55290_7723dc04/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v13.kuaichezym3u8.com/yyv13/202606/30/MjvrwyQkqb27/video/index.m3u8"}]},{"sourceName":"动漫发布 (okm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"HD","url":"https://v13.yaaabc.com/yyv13/202606/30/MjvrwyQkqb27/video/index.m3u8"}]},{"sourceName":"动漫发布 (sdm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"HD","url":"https://v13.qqqrst.com/yyv13/202606/30/MjvrwyQkqb27/video/index.m3u8"}]}]},{"id":"502a099da938846d6147d33aeb214055","title":"锦鲤人间之如愿以偿","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260629-1/f2725a846225ad53281b1fe4368267a3.jpg","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"","director":"","des":"<p>弟弟李鲸被暗玉浊气侵蚀危在旦夕，父亲李鲲离奇失踪，走投无路的少年李鲥，在家传鲲佩的指引下，召唤出来自鲲域的锦鲤仙李鲤。为报李家先祖的救命之恩，傲娇灵动的锦鲤仙与执着坚定的人间少年，结伴踏上了一场险象环生的大冒险。</p>","last":"2026-06-29 18:17:40","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260629/bHQaGfMT/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v1.ppqrrs.com/202606/29/M9fZfuGtcL87/video/index.m3u8"}]}]},{"id":"ae2a4fdb850e6dee87c5cb4d5bfc2d77","title":"关于我转生变成史莱姆这档事 苍海之泪篇","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260509-1/1f00a0dc6d409022ff86630f63973581.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"堂本光一","director":"菊地康仁","des":"<p>舞台设定在崇拜水龙守护神的海底王国「海炎国」，这里因神秘污染和“强行唤醒沉睡水龙”的阴谋陷入危机。利姆露一行人原本是来海岛度假，却被卷入这场深海危机，从悠闲摸鱼被迫营业，潜入苍海深处揭开阴谋、阻止海底文明覆灭。</p>","last":"2026-06-26 22:10:38","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260626/RDaGkHxW/index.m3u8"}]}]},{"id":"6f7619df55fbcd36f752308e4438846d","title":"蚂蚁传奇之烈火重生","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260623-1/a9364c9d85fe32be3b61f5cd35429ddd.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"HD国语","actor":"","director":"陈铭艺","des":"<p>　蚂蚁战队为守护家园，与雷、仇两路人马展开圣兽力量的争夺，最后决战于炽火塔内。在圣兽感召下，蚂蚁战队逆转局势，并将敌人击退！所有人也得到圣兽力量的洗礼，心灵和实力都得到了重生，并携手向更高目标迈进。</p>","last":"2026-06-23 17:19:01","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260623/deQf5YX7/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v6.ppqrrs.com/wjv6/202606/23/wquXXatGVz91/video/index.m3u8"}]}]},{"id":"081c0aeafc39a378b227f506dff8d3de","title":"白蛇传之我叫王道灵","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260622-1/9d275bf4c7d5e6b20eeea96982b258ed.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"","director":"鳄梨","des":"<p>　本片为AIGC创作作品，以考古式手法还原古籍《白蛇传》原始情节。故事跳出以往影视版本的固有设定，从常被塑造成反派的蛤蟆精王道灵视角展开，探讨天道规则与个体公道之间的三界纠葛，致敬所有被主流叙事埋没、遗忘的平凡众生。</p>","last":"2026-06-22 22:53:51","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260622/Dj4ufyq1/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v7.ppqrrs.com/wjv7/202606/24/gMzK4P2Q5Q94/video/index.m3u8"}]}]},{"id":"2ef76e6e56ee5c3ac81c436667f672d7","title":"我住在凡尔赛的日子2025","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260610-1/3bbbb349b6f24eaafaa98378e66f0347.webp","lang":"法语","area":"卢森堡 / 法国","year":"2025","note":"正片","actor":"尼娜·佩雷斯-马拉尔特 / 埃米·卢卡斯-维吉耶 / 马尔科姆·瓦莱 / 安娜·阿尔瓦罗 / 席琳·荣特 / 雅各布·韦伯 / 阿丽亚娜·阿斯卡里德 / 蒂埃里·莱尔米特 / 安托万·赖纳茨 / 雷南·克罗斯 / 朱利安·西布尔 / 乌苏比-朱尼尔·福法纳 / 马杜苏·卡马拉 / 杰内莉亚·科阿杜 / 玛佳丽·罗森茨威格","director":"纳撒尼尔·赫利米 / 克莱曼斯·马德琳-佩德里亚特","des":"<p>　故事围绕着八岁的维奥丽特展开。在父母离世后，她搬到了脾气暴躁的舅舅雷吉斯家中生活。雷吉斯是凡尔赛宫的一名维修工人。他们一起度过了人生中的种种难关，在凡尔赛宫的历史背景下建立了深厚的感情。</p>","last":"2026-06-10 13:25:00","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260610/hDBb9Mup/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/fb1378d0b80ae44aae0000a3cff0b90f"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260524/6659_2edc4e37/index.m3u8"}]}]},{"id":"b8ae992d8e71c95376be1bb6cc023292","title":"小鲨鱼去郊游2025","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260609-1/3fb53034a3dd44db697ff97187d12302.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"花泽香菜 / 潘惠美 / 久野美咲","director":"熊野千寻","des":"<p>动画《小鲨鱼去郊游》宣布制作电影版</p>","last":"2026-06-09 19:29:40","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260609/i7e5BcyK/index.m3u8"}]}]},{"id":"e536329f9186c23dc161cb55241cc8a6","title":"劇場版 うたの☆プリンスさまっ♪ TABOO NIGHT XXXX","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260609-1/f68ea87e0fa4ee14d4e57473e412f721.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"森久保祥太郎 / 铃木达央 / 苍井翔太 / 前野智昭","director":"关晓子","des":"<p>人気ゲームソフトを原作に、2011〜16年に4期にわたり制作されたテレビアニメ「うたの☆プリンスさまっ♪　マジLOVE」シリーズに登場するアイドルたちのライブを描く劇場版第3弾。</p><p>　　音楽・舞台・ドラマ・映画・バラエティなどそれぞれの個性を生かしてソロ活動を行なっていた寿嶺二、黒崎蘭丸、美風藍、カミュの4人により結成されたアイドルグループ「QUARTET NIGHT（カルテットナイト）」。「ST☆RISH」や「HE★VENS」と共演したライブ「マジ LOVELIVE キングダム」では抜群のハーモニーと完成度の高いダンスパフォーマンスを披露した。そんな彼らが繰り広げるライブを、前2作と同じく全編ライブアニメーション＆完全オリジナルでスクリーンに映しだす。</p><p>　　テレビアニメ第4期および劇場版第1作「劇場版　うたの☆プリンスさまっ♪　マジ LOVE キングダム」の古田丈司が総監督を務め、シリーズ全作を手がけてきたA-1 Picturesがアニメーション制作を担当。</p><p><br/></p>","last":"2026-06-09 19:11:28","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260609/fWFfDr6X/index.m3u8"}]}]},{"id":"bfee8ca2a97c9ade4b348868574a6c32","title":"佐贺偶像是传奇 梦想银河乐园","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260607-1/fd7f4cac064a839e6222f67d5f0f66e5.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"宫野真守 / 本渡枫 / 田野麻美 / 种田梨沙 / 河濑茉希 / 衣川里佳 / 田中美海 / 三石琴乃","director":"宇田钢之介 / 佐藤威 / 石田贵史","des":"<p>佐贺的存亡，托付给了僵尸偶像＜芙兰秀秀＞——！</p><p>　　被神秘制作人巽幸太郎复活的僵尸们，化身佐贺当地偶像＜芙兰秀秀＞展开活动。2025年，因佐贺世博会而沸腾的地球。正当成员们作为世博大使筹备终极舞台时，威胁人类的＜某种存在＞却悄然逼近——！佐贺将何去何从！？地球命运将走向何方！？此刻，这场空前绝后的银河盛典电影即将拉开帷幕——！！</p><p><br/></p>","last":"2026-06-07 14:13:17","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260607/n2bMoVOd/index.m3u8"}]}]},{"id":"bbe245cb734cc4170c6b832af38d0149","title":"银河特急 Milky✩Subway 各站停车前往剧场","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260604-1/78b277ef5ebf88624d95600b7eb9bac2.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"寺泽百花 / 永濑安奈 / 金元寿子 / 小市真琴 / 内山昂辉 / 山谷祥生 / 小松未可子 / 藤原由林","director":"龟山阳平","des":"<p><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　銀河道路交通法違反で逮捕された強化人間のチハルとサイボーグのマキナ。</span><br/><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　同じタイミングで警察に捕まった、強化人間のアカネとカナタ、サイボーグのカートとマックスらクセのあるコンビを集め、警察官・リョーコが全員に課したのは、奉仕活動として惑星間走行列車・通称”ミルキー☆サブウェイ”の清掃をすること。</span><br/><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　簡単な任務だったはずが、突如暴走し始める”ミルキー☆サブウェイ”！</span><br/><span style=\"color: rgb(17, 17, 17); font-family: Helvetica, Arial, sans-serif; font-size: 13px; background-color: rgb(255, 255, 255);\">　　車内で慌てふためくメンバーたち。リョーコも同僚のアサミとともに解決に向けてあれこれするが、やがて一行は大事件に巻き込まれていくことに……！</span></p>","last":"2026-06-04 01:31:02","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260603/1gOz9MoV/index.m3u8"}]}]},{"id":"8430bed29cdc58e74416e5f77d009b5f","title":"熊出没·年年有熊","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260220-1/19ec44675617b8fefa13059ae1cd22ee.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"张秉君 / 张伟 / 谭笑","director":"林汇达","des":"<p>熊大曾是森林里的“老大哥”，直到一个不速之客到来，它将自己神力传给了熊强，熊大变成了三人组合内能力最弱者。为了改变现状，他步入了反派陷阱，引发了毁天灭地的危机......</p>","last":"2026-05-31 11:51:04","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260531/jNPwu2sl/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/6097d8f3714205740f30debe1166744e"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260531/6790_66e5f714/index.m3u8"}]}]},{"id":"b791fb4df2856d07a2402ddd703d463c","title":"超级马力欧银河大电影","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260521-1/b371b2c556f5149a9801e9faa182b39a.webp","lang":"英语","area":"日本 / 美国","year":"2026","note":"正片","actor":": 克里斯·帕拉特 / 安雅·泰勒-乔伊 / 查理·戴 / 杰克·布莱克 / 布丽·拉尔森 /","director":": 亚伦·霍瓦斯 / 迈克尔·杰勒尼克","des":"<p>　重返奇妙世界，探索浩瀚宇宙，罗莎塔公主、酷霸Jr.、耀西等更多惊喜角色登场，开拓更宏大酷炫的版图，呈现更精彩纷呈的冒险。</p>","last":"2026-05-21 00:21:12","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260520/cVan1RVb/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/8c5149362e6e7f7947fd2f578df6b575"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260514/6349_a896a0d8/index.m3u8"}]}]}]}]
