0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"w-full flex flex-col gap-8 md:gap-12","children":[["$","$L2",null,{"bannerList":[{"id":"ced5926d6d9614292bc5b4f2581b95ac","title":"角头：大桥头","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260708-1/ba7cfed331c94a18bdf77d8389a615be.webp","lang":"闽南语 / 汉语普通","area":"中国台湾","year":"2026","note":"正片","actor":"蔡振南 / 龙天翔 / 喜翔 / 高捷 / 太保 / 夏靖庭 / 孙鹏 / 王识贤 / 王阳明 / 张怀秋 / 施名帅 / 郑人硕 / 张再兴 / 黄尚禾 / 吴震亚 / 唐振刚 / 李铭忠 / 黄冠智 / 隆宸翰 / 江治纬 / 陈万号 / 白吉胜 / 王宣","director":"姚宏易 / 姜瑞智","des":"<p>　大桥头第二代接班人麦克（王阳明 饰）强势崛起，瞒着父亲与兄弟（张怀秋 饰）暗中重整角头新秩序，他以狠辣手段清除异己，妄图收拢地盘。此举瞬间触动多方利益，北馆、顶庄、北城三大势力联手围剿，昔日江湖平衡彻底破碎，四方角头全面开战。在义气、血脉与权力的绞杀里，谁才是新一代黑道传奇？</p>","last":"2026-07-08 18:30:53","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260708/qB76qqS6/index.m3u8"}]}]},{"id":"ecedee02d01d88317a1100b4141ac82a","title":"火遮眼2025","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260708-1/6373126587d836d5d3097ae26f48a277.webp","lang":"汉语普通话 / 英语","area":"中国香港 / 中国大陆","year":"2025","note":"更新HD","actor":"谢苗 / 林科灯 / 杨恩又 / 黎唯 / 雅彦·鲁伊安 / 杰佳·亚宁 / 岩永丞威 / 萨哈贾克·波斯安吉特 / 玛娜莎楠·潘叻翁固 / 郭峻卿 / 威奈·旺扬功 / 萨哈查·楚姆鲁姆 / 马鲁特·乍伦素 / 桑尼·查特维里亚猜 / 查亚尼·里提玛","director":"谷垣健治","des":"<p>　东南亚某处，失语维修工王伟（谢苗 饰）因女儿雨晴（杨恩又 饰）失踪觉醒猎杀本能。他联手寻妻记者纳文（林科灯 饰）组成生死同盟，在连番血战中死斗黑暗组织打手大块头（黎唯 饰）与嗜血杀手阿德（雅彦·鲁伊安 饰）一众人等。怒火遮眼，鲜血开路，从血肉翻飞的街头混战，到拳拳断骨的室内死斗，一场又一场血腥残暴的生死拼杀连番上演，与此同时雨晴也在魔窟中用父亲教的功夫自救。随着二人深入敌营，真相直指背后更庞大的黑恶势力。</p>","last":"2026-07-08 13:24:04","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260708/2srvI17E/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"TC","url":"https://b3.bdzybf22.com/videos/202606/11/6a2a55a32394fd5f7042a76a/gf6748/index.m3u8"},{"name":"HD","url":"https://b3.bdzybf22.com/videos/202607/07/6a4cc7636ad3eb5f71d61095/bf750a/index.m3u8"}]},{"sourceName":"爱弹幕 (okm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"TC","url":"https://v5.yaaabc.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"爱弹幕 (wjm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v7.ppqrrs.com/wjv7/202607/07/gHPirMfK7486/video/index.m3u8"}]},{"sourceName":"爱弹幕 (sdm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"TC","url":"https://v5.qqqrst.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"爱弹幕 (ffm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://vip.ffzy-play10.com/20260707/69472_74145de4/index.m3u8"}]},{"sourceName":"爱弹幕 (kcm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"TC","url":"https://v5.kuaichezym3u8.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.yzzy28-play.com/20260707/32256_139ccdbf/index.m3u8"}]},{"sourceName":"动漫发布 (okm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"TC","url":"https://v5.yaaabc.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v7.ppqrrs.com/wjv7/202607/07/gHPirMfK7486/video/index.m3u8"}]},{"sourceName":"动漫发布 (sdm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"TC","url":"https://v5.qqqrst.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"动漫发布 (ffm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://vip.ffzy-play10.com/20260707/69472_74145de4/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"TC","url":"https://v5.kuaichezym3u8.com/yyv5/202606/11/UV17AG39gd24/video/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.yzzy28-play.com/20260707/32256_139ccdbf/index.m3u8"}]}]},{"id":"124f00ac3f26134ce8680d4541805486","title":"万米危机","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260703-1/921871ee2fc3c46003e846af4e2ff3f9.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"释小龙 / 伊科·乌艾斯 / 屈菁菁 / 刘峰超 / 任天野 / 陶海 / 夏若妍 / 高毅 / 洪爽 / 黄涛 / 班玛加","director":"秦鹏飞 / 释小龙","des":"<p>　空警顾朝阳为挽回女友董璐，临时登上飞往乌莱亚的国际航班。航班上暗藏危机，一伙歹徒密谋劫机，通讯中断、机舱陷入混乱，万米高空瞬间变成绝境。顾朝阳迅速察觉异常，联合空警与机组人员，在密闭机舱内与隐藏的劫机分子展开紧张对峙与周旋，全力守护机上乘客安全。</p>","last":"2026-07-03 11:27:56","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260703/MWVyX6pt/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/share/1afd71d0597a1948560c79080eda548f"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202607/03/6a475b280452185f5987c4b6/2f643a/index.m3u8"}]},{"sourceName":"爱弹幕 (hnm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/eVOvwjBa/index.m3u8"}]}]},{"id":"3c34f0c6996e01875583c2a3302ae86d","title":"福尔摩斯小姐3","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260701-1/017fae42f77739d0ac1ee038f6168f0e.webp","lang":"英语","area":"美国","year":"2026","note":"更新HD","actor":"米莉·波比·布朗 / 亨利·卡维尔 / 海伦娜·伯翰·卡特 / 路易斯·帕特里奇 / 希米什·帕特尔 / 莎伦·邓肯-布鲁斯特 / 贝恩·科拉科 / 乔·阿佐帕迪 / 彼得·温菲尔德 / 迈克·帕里什 / 泰勒·瓦莱丽 / 罗德里格·安德里桑 / 库尔特·拉费尔拉 / 利亚姆·杰弗里 / 马克西姆·杜兰德 / 亚历克斯·加斯佩雷蒂 / 西奥多·扎米特","director":"菲利普·巴兰蒂尼","des":"<p>冒险追逐着侦探伊诺拉·福尔摩斯小姐来到马耳他，在那里，她的个人梦想和职业梦想碰撞在一起，她所面对的案件比以往任何案件都更加纠结和诡谲……</p>","last":"2026-07-01 19:59:09","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260701/H1GhOWYh/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/share/ab9bc301ed969f5fa62e9908d7fd80e7"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202607/01/6a450ac02394fd5f704e091f/d71be8/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.yzzyvip-29.com/20260701/25347_9a1a05c4/index.m3u8"}]}]},{"id":"09a0f67bd1523cebb59aba96e67c3fbb","title":"公民义警","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260627-1/b8150e939c80217fe375c2fffcee1f59.webp","lang":"英语","area":"克罗地亚 / 德国","year":"2026","note":"更新HD","actor":"艾米·汉莫 / 科斯塔斯·曼迪勒 / 本杰明·施诺 / 维叶克斯拉维·卡图汀 / Dora Dimic Rakar / Jenny Paris / Neb Chupin / 阿洛娜·赫塔 / Dino Keric / Elizabeth Zacero / Steffen Mennekes / Roni Lepej / Mukit Abdul Hamid / Hila Harush / Kresimir Simac / Ema Masala / Tino Trkulja / Danijela Evdjeni","director":"乌维·鲍尔","des":"<p>　居住在克罗地亚萨格勒布的美国富商桑德斯，继承了父亲留下的庞大地产帝国，却亲眼见证暴力罪犯、性侵者与腐败法官一次次凭借规则漏洞逃脱法律制裁，对整个司法体系彻底失望。他褪去富商身份化身地下义警，以自己的方式对漏网之鱼执行审判。他的私刑行动被路人拍下传遍社交网络，迅速爆红成为民间追捧的正义符号，也引来了国际刑警长官亨利的全力追捕。两人在城市街巷里展开步步紧逼的猫鼠博弈，法外正义与执法体系的碰撞愈演愈烈。</p>","last":"2026-06-27 13:47:20","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260627/1bjVwnY3/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/share/e530eb364302c7bc23d19d0575a7d9cd"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn27.com/20260627/12186_9cb3e5c9/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202606/24/6a3b8cdf9ed9215f583acf12/feb6cd/index.m3u8"}]}]},{"id":"9cb7e7ea8359d24ca4b0445af0a4596f","title":"飞虎神爪","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260612-1/d7f6f1c482e80e57f527c4b63588ae53.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"程琢 / 孙文雪 / 任宇 / 淳于珊珊","director":"田少波","des":"<p>飞虎门郑坤奉命押送赈灾粮，他押送回来的赈灾粮全是沙石，郑坤锒铛入狱，几经周折，郑坤查出调换赈灾粮的罪魁祸首，郑坤与州府捕快左绫联手将贪污赈灾粮的人一干人等绳之以法，将他们一网打尽</p>","last":"2026-06-12 13:44:37","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260612/UeoxWAzM/index.m3u8"}]}]}]}],"$L3","$L4","$L5","$L6"]}],["$L7"],"$L8"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"j0u415rOgZaH1_S1B5JML"}
3:["$","$L9",null,{"title":"热播电影","keyName":"dianying","videos":["$0:rsc:props:children:0:props:children:0:props:bannerList:0","$0:rsc:props:children:0:props:children:0:props:bannerList:1","$0:rsc:props:children:0:props:children:0:props:bannerList:2","$0:rsc:props:children:0:props:children:0:props:bannerList:3","$0:rsc:props:children:0:props:children:0:props:bannerList:4","$0:rsc:props:children:0:props:children:0:props:bannerList:5",{"id":"62a76ee0aa3776ab6a64fcc1c53bdc33","title":"镖人：风起大漠","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260218-1/54afea603d88d1c2d30bd2b5b7a6bb6e.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"吴京 / 谢霆锋 / 于适 / 陈丽君 / 孙艺洲 /","director":"袁和平","des":"<p>大漠之上，镖人、官府、西域五大家族等多方势力盘根错节、暗潮涌动。“天字第二号逃犯”刀马接下特殊押镖任务，和同伴一起从西域护镖远赴长安。不料，他们的护送对象竟是“天字第一号逃犯”知世郎……天下熙熙皆为利来，各方势力闻风入局，抢镖厮杀接连上演……</p><p>镖人：风起大漠的演职员 · · · · · ·&nbsp;</p>","last":"2026-06-11 11:28:21","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260611/RwHn6MsT/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/955d864a62659945cc9434898e275deb"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260612/7029_bc90ae8d/index.m3u8"}]}]},{"id":"be8b169981d8f24a4387df3099e56cf8","title":"真人快打2","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260509-1/02b1dff3c6d2c66554b2d961f1979220.webp","lang":"英语","area":"美国","year":"2026","note":"正片","actor":"演: 卡尔·厄本 / 阿德莱恩·鲁道夫 / 杰西卡·麦克娜美 / 约什·劳森 / 马丁·福特 /","director":"西蒙·麦奎德","des":"<p>　过气好莱坞演员强尼·凯奇（卡尔·厄本 饰）被意外选中，加入一场决定地球命运的真人快打。吉塔娜（阿德莱恩·鲁道夫 饰）、刀锋索尼娅（杰西卡·麦克娜美 饰）、卡诺（约什·劳森 饰）、刘康（林路迪 饰）、贾克斯（麦卡德·布鲁克斯 饰）、尚宗（黄经汉 饰）、雷电（浅野忠信 饰）、避寒（乔·塔斯利姆 饰）、蝎子（真田广之 饰）等角色也将各显身手，开启血浆狂飙的格斗厮杀。</p>","last":"2026-06-08 21:34:24","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260608/S9GF6mQD/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/6f5e4e86a87220e5d361ad82f1ebc335"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260609/6963_a455ad8d/index.m3u8"}]}]},{"id":"80ac428ff5511408013b950e556babb0","title":"导火线2025","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260408-1/de53dc02bb6cd12957faaf58ee6a93f2.webp","lang":"英语","area":"英国","year":"2026","note":"正片","actor":"亚伦·泰勒-约翰逊 / 西奥·詹姆斯 / 萨姆·沃辛顿 / 古古·姆巴塔-劳 / 卢克·梅伯利 /","director":"大卫·马肯兹","des":"<p>　伦敦一个建筑工地发现了一枚未爆炸的二战时期炸弹，当拆弹专家前来处理时，引发了大规模疏散，同时也为一场银行抢劫提供了完美的掩护。</p>","last":"2026-06-08 13:08:47","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260608/ikQ2DQsX/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/share/ccce2fab7336b8bc8362d115dec2d5a2"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lzcdn31.com/20260608/6935_900bc92d/index.m3u8"}]}]},{"id":"c09cda401aa0bf41c7951fdd68357f18","title":"末日逃生2：迁移国语","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260528-1/1f9afa027849484ff3ed7857da97934f.webp","lang":"英语","area":"英国 / 美国","year":"2026","note":"正片","actor":"杰拉德·巴特勒 / 莫蕾娜·巴卡琳 / 罗曼·格里芬·戴维斯 / 奈丽娅·达科斯塔 / 托米·厄尔·詹金斯 / 斯荣德·福斯·奥瓦格 / 苏菲·汤普森 / 威廉·阿巴迪 / 吉斯利·厄恩·加达松 / 艾波·罗丝·雷瓦 / 吉娜·甘格尔 / 安东尼奥·德利马 / 彼得·多卡普 / 贝鲁斯·坎 / 梅根·雅各布·希利瓦斯塔娃 / 米图·帕尼库奇 / 西塞尔·西姆·科赫 / 法拉斯·M·坎 / 纳森·威利 / 戈登·亚历山大 / 亚历克斯·拉尼佩坤 / 沙因·赫恩顿 / 雷切尔·伊芙琳","director":"里克·罗曼·沃夫","des":"<p>　由于宇宙中的两颗彗星正面撞击了地球，致使地表生态遭遇毁灭性打击，造成恶劣后果。全人类不得不躲藏在地堡中求得生存。身为科学家的约翰·加里蒂（杰拉德·巴特勒 饰）带着一家人劫后余生，幸存了下来。虽然他们躲过了第一波的冲击，但是他们所在的地堡中剩余的生活物资逐渐减少，其他幸存的人类也开始蠢蠢欲动。迫于压力这一家人必须离开格陵兰岛的安全掩体，开始踏上危险的旅程。在这一路上他们无奈的发现，整个欧洲已经被毁灭，变成了冰冻荒地。于是一家人只能再次被迫上路，最终，他们找到了新的栖身之所。</p>","last":"2026-05-27 19:12:20","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260527/Ze25GFQ5/index.m3u8"}]}]},{"id":"a9f9efb04195ce818f386e06fcb74041","title":"末日逃生2：迁移","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260528-1/83aa59ddfa3ec604cb6a6682498566d2.webp","lang":"英语","area":"英国 / 美国","year":"2026","note":"正片","actor":"杰拉德·巴特勒 / 莫蕾娜·巴卡琳 / 罗曼·格里芬·戴维斯 / 奈丽娅·达科斯塔 / 托米·厄尔·詹金斯 / 斯荣德·福斯·奥瓦格 / 苏菲·汤普森 / 威廉·阿巴迪 / 吉斯利·厄恩·加达松 / 艾波·罗丝·雷瓦 / 吉娜·甘格尔 / 安东尼奥·德利马 / 彼得·多卡普 / 贝鲁斯·坎 / 梅根·雅各布·希利瓦斯塔娃 / 米图·帕尼库奇 / 西塞尔·西姆·科赫 / 法拉斯·M·坎 / 纳森·威利 / 戈登·亚历山大 / 亚历克斯·拉尼佩坤 / 沙因·赫恩顿 / 雷切尔·伊芙琳","director":"里克·罗曼·沃夫","des":"<p>　由于宇宙中的两颗彗星正面撞击了地球，致使地表生态遭遇毁灭性打击，造成恶劣后果。全人类不得不躲藏在地堡中求得生存。身为科学家的约翰·加里蒂（杰拉德·巴特勒 饰）带着一家人劫后余生，幸存了下来。虽然他们躲过了第一波的冲击，但是他们所在的地堡中剩余的生活物资逐渐减少，其他幸存的人类也开始蠢蠢欲动。迫于压力这一家人必须离开格陵兰岛的安全掩体，开始踏上危险的旅程。在这一路上他们无奈的发现，整个欧洲已经被毁灭，变成了冰冻荒地。于是一家人只能再次被迫上路，最终，他们找到了新的栖身之所。</p>","last":"2026-05-27 19:11:11","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260527/88IUnjAv/index.m3u8"}]}]},{"id":"67f356ce2e2ab88d4a8e707e3ae99ad3","title":"插翅难飞2026","type":"dianying","pic":"https://www.imgzy360.com:7788/upload/vod/20260526-1/970f02fba102f7f51cd4bda205622d1f.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"曲高位 / 黄勐 / 童飞","director":"胡利峰","des":"<p>　在九十年代的江北市，刑警雷鸣与新人方晴在缉捕阴狠悍匪姜虎的过程中，陷入生死博弈。绑架、炸弹、卧底与假扮交换人质轮番上演，忠诚与背叛交织。最终警队以血肉之躯筑起钢铁防线，在惨烈对抗中迎来正义与牺牲的终局。</p>","last":"2026-05-26 12:09:15","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260526/wrC73EES/index.m3u8"}]}]}]}]
4:["$","$L9",null,{"title":"热播电视剧","keyName":"dianshi","videos":[{"id":"9a72d2c4e19d9731f2ed7d20032b6938","title":"夫妻的博弈粤语","type":"dianshi","pic":"https://www.imgzy360.com:7788/upload/vod/20260710-1/c8a9e01bb6068656d35ab6438c97eca5.webp","lang":"粤语","area":"中国香港 / 中国大陆","year":"2026","note":"更新至第08集","actor":"高海宁 / 马国明 / 张颕康 / 郭柏妍 / 黄智贤 / 陈晓华 / 游嘉欣 / 何广沛 / 邓智坚","director":"钟澍佳 / 黄国辉","des":"<p>　　罹癌的女主角姜幸如親眼目睹老公和她唯一的閨蜜的姦情，慘遭兩人狠下毒手。坎坷的她竟然「死而復生」，奇迹地回到五年前⋯獲得「重生」的幸如決定為自己而活，她任職廣告公司高層，從名貴奢侈品到生活必需品，為各種商品量身訂造創意特色的廣告。當幸如「重啓人生」後，換上亮麗的外型，藉著從「未來」帶回來的「預知能力」，獲得先機，本已有實力的她更揮灑自如，帶領女同事組成粉紅兵團，女力逆襲，各人發揮埋沒已久的超卓實力，創作一個又一個打動人心的廣告。</p><p>　　幸如和粉紅兵團，與公司內的「渣男s」博弈，同時爲追求幸福而戰，扭轉了命運，成為了自己的英雄，如一個廣告的 tagline 一一「拯救自己 實現美夢 Ican be my own Shero」。</p><p><br/></p>","last":"2026-07-12 12:19:55","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"第01集","url":"https://vod1.maowushi.com/20260710/twX0apVH/index.m3u8"},{"name":"第02集","url":"https://vod1.maowushi.com/20260710/9GICsL2A/index.m3u8"},{"name":"第03集","url":"https://vod1.maowushi.com/20260710/EpFCYQcj/index.m3u8"},{"name":"第04集","url":"https://vod1.maowushi.com/20260711/Fye91S4m/index.m3u8"},{"name":"第05集","url":"https://vod1.maowushi.com/20260711/U9FYJJTM/index.m3u8"},{"name":"第06集","url":"https://vod1.maowushi.com/20260711/DYteyGgQ/index.m3u8"},{"name":"第07集","url":"https://vod1.maowushi.com/20260712/GM2B2iSb/index.m3u8"},{"name":"第08集","url":"https://vod1.maowushi.com/20260712/jiU9gVS7/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"第01集","url":"https://v.lzcdn27.com/share/037ca1e2c1f5248ac197f1086bedfa68"},{"name":"第02集","url":"https://v.lzcdn27.com/share/4de9b7822e0de81fc734bc5689ab6f03"},{"name":"第03集","url":"https://v.lzcdn27.com/share/58dcf38e3941ea8a0e4bd27dca3326a4"},{"name":"第04集","url":"https://v.lzcdn27.com/share/2316788c9a61179830bbe49c5e767369"},{"name":"第05集","url":"https