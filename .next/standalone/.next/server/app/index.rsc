13:["$","$L17",null,{"title":"热播电影","keyName":"dianying","videos":["$8:props:children:0:props:bannerList:0","$8:props:children:0:props:bannerList:1","$8:props:children:0:props:bannerList:2","$8:props:children:0:props:bannerList:3","$8:props:children:0:props:bannerList:4","$8:props:children:0:props:bannerList:5",{"id":"678ab23248c5d8decde5b6efeff40e43","title":"海墓寻龙","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260810-1/1ff4e2ebe1ebc0f5276b4e40d07314ed.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"赵仁杰 / 付美 / 洪天照 / 张晶 / 振宇","director":"魏玉海","des":"<p>　九星连珠之际，沈万九海墓随岛浮现，引发各方势力觊觎。江湖侠盗天涯为查救灾粮掺假一事夜探粮仓，却遭人设计，被迫卷入纷争，于是他与苦寻失踪父亲的天海船帮帮主郑浅浅、沈家后人沈朝闻结盟，共赴烛龙岭，夺取开启海墓的钥匙——龙须。 众人驾“萤火号”闯过迷雾鬼船、鲸口滩等重重险关，终将海墓开启，得见沈家宝物——番天印。不料，这一切都是沈朝闻为得番天印之力所设之局。众人得知真相，分崩离析，正邪大战，于海墓上演。</p>","last":"2026-08-10 12:12:46","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260810/nwo1Xz8A/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/859bf1416b8b8761c5d588dee78dc65f"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/10/6a793fdf2394fd5f707ed143/de69e1/index.m3u8"}]},{"sourceName":"爱弹幕 (lzm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260811/9386_9f5dfc40/index.m3u8"}]},{"sourceName":"动漫发布 (lzm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260811/9386_9f5dfc40/index.m3u8"}]}]},{"id":"17c28768b634aa6c762611b369df3c28","title":"港城大劫案","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260808-1/719c98d7ac68efa766c90ae59418aee9.jpg","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"","director":"","des":"<p>90年代中国香港，三位深陷生存绝境的底层小人物，因一场劫案命运交织。押款员唐月玲急需巨款为心脏病父亲做移植手术；搭档李国荣遭杀猪盘骗光积蓄，还面临失业危机；街坊丧坤在黑帮九纹龙手下谋生，不慎弄丢社团钱款，遭黑帮全城追杀。走投无路的唐月玲与丧坤打算抢夺黑帮钱财，行动失败偶遇李国荣，行车记录仪拍下二人图谋。李国荣顺势提议联手打劫押款车，计划借大坑舞火龙盛典人流管制实施行动，三人在煎熬中达成共识。 行动当晚局势彻底失控：追杀丧坤的黑帮、全副武装的南亚悍匪、本欲假意劫车的三人形成三方混战。三人不忍伤及无辜，驾车转移至僻静处，凭借安保专业能力拼死制服悍匪，押运现金却在激战中焚毁。所幸损失由保险全额赔付，三人因挺身而出勇斗歹徒获得公司嘉奖。丰厚奖金化解所有人困境，唐父手术顺利，丧坤告别黑道拜师经营烧鹅店。影片借跌宕劫案，刻画普通人在金钱诱惑下的道德挣扎，传递坚守底线、向善终有出路的正向内核。</p>","last":"2026-08-08 19:28:46","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260808/QBSxXCUQ/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/08/6a7700c52394fd5f707dc322/64ef36/index.m3u8"}]}]},{"id":"5e9078e9e58537a2fd2d9324db03e310","title":"破暗","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260808-1/cc915b8cb69392c38914b553173270f6.jpg","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新HD","actor":"","director":"","des":"<p>大康太师闻宇阳宴请皇上义子神策府神威将军冷啸天，席间告知他一个消息，刚刚继任北疆镇海王的薛世明遭刺客暗杀，大康名医李长生父子卷入其中，不日将斩首。冷啸天自幼在北疆长大，李长生曾对他有过救命之恩，冷啸天决定亲赴北疆。探求真相...</p>","last":"2026-08-08 18:28:05","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260808/LiQZ5mYT/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/08/6a7700da2394fd5f707dc378/1e38bc/index.m3u8"}]}]},{"id":"5de26f572c603f90ddc50ab68c2bd931","title":"野兽赛跑","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260808-1/2cd43ccd06cebbb3beacdc835406e720.webp","lang":"葡萄牙语","area":"巴西","year":"2026","note":"正片","actor":"马修斯·阿布雷乌 / 阿妮塔 / 阿兹 / Camillo Borges / Higor Campagnaro / Perla Carvalho / Ana Chagas / Chao Chen / 杰西卡·科雷斯 / Leo Corleone / Andre Curti / Camilla de Lucas / Paulo Vieira de Melo / Renato de Souza / Gabriel Ángel Delgado","director":"费尔南多·梅里尔斯 / Rodrigo Pesavento / Ernesto Solis","des":"<p>　在反乌托邦里约热内卢废墟中，城市被阶级斗争撕裂，人们沉迷于血腥竞技。一位抵抗运动领袖为拯救妹妹免于遭遇比死亡更惨烈的命运，被迫卷入一场暴力而高风险的竞赛。</p>","last":"2026-08-08 14:28:19","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260808/0o69DIo7/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/a9883e7bb20e56060778cf794125afc4"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260809/9353_f38b9db5/index.m3u8"}]}]},{"id":"6b938aaae53db035f58f1bf9819ef417","title":"热血江湖","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260808-1/9467f2279726f50dde70992f6d786c7a.jpg","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"","director":"","des":"","last":"2026-08-08 14:16:42","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260808/MVBSepPU/index.m3u8"}]}]},{"id":"36acce25d58a56b92fc3a824e875f472","title":"最后孤屋","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260807-1/a50da8254e1add565cf19fb22b9fbb70.webp","lang":"英语","area":"英国 / 法国 / 美国","year":"2026","note":"更新HD","actor":"格蕾塔·李 / 瓦格纳·马拉 / 西德·爱德华兹 / 刘易斯·古迪 / 奥黛丽·安德森 / 南希·鲍德温 / 陶妮·丰塔纳 / 杰德·奥金 / 奥利弗·亨利·阿诺德 / 加百列·钟 / 费莉西蒂·鲍恩 / Riley Chung / 艾玛·霍 / 诺亚·亚历山大·索斯诺夫斯基","director":"路易斯·莱特里尔","des":"<p>　　一个普通的一家四口突遭诡异变故，被困在自家房屋中超过 1000 天无法出门。在资源消耗殆尽与未知神秘威胁的双重逼迫下，一家人必须想方设法联手求生，打破这间禁锢生命的困局。</p>","last":"2026-08-07 19:11:09","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260807/kjzURtxa/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/0dc11dc170cd8836e9f1c111b19a6e03"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260809/9351_32137615/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/07/6a75a7e62394fd5f707c6637/ca0b48/index.m3u8"}]}]}]}]
14:["$","$L17",null,{"title":"热播电视剧","keyName":"dianshi","videos":[{"id":"30993609e3340d7a5c4ed641eb783865","title":"早春晴朗","type":"dianshi","typeName":"国产剧","pic":"https://www.imgzy360.com:7788/upload/vod/20260826-1/354982ff374903eae21f9968fd4ee1ad.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新至第11集","actor":"井柏然 / 孙千 / 刘小北 / 齐天晴 / 张晔子 / 宁心 / 赵振宇 / 张优 / 彭杨 / 郭晓婷 / 李川","director":"蒋继正","des":"<p>这是一段敬于才华，合于性格、久于平等的禁忌之恋。极具天盛的“鬼才”栾念与北漂伊始的尚之桃狭路相逢。热烈勇敢的尚之桃亦步亦趋地蜕变成长，撬碎了栾念世故坚硬的心防，互相吸引的二人在都市丛林中极限拉扯、分分合合。爱情，就是用光所有勇气，再无遗憾。爱，则是互相修复，共同成长。在情和爱之间，他逐渐收敛锋芒，她开始独当一面，势均力敌的他们将会为彼此写下新的结局……</p><p>　　该剧根据姑娘别哭同名小说改编。</p><p><br/></p>","last":"2026-08-30 12:44:11","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"第01集","url":"https://vod1.maowushi.com/20260826/BMCPZ1le/index.m3u8"},{"name":"第02集","url":"https://vod1.maowushi.com/20260826/keXd0Whq/index.m3u8"},{"name":"第03集","url":"https://vod1.maowushi.com/20260826/cg56dH8d/index.m3u8"},{"name":"第04集","url":"https://vod1.maowushi.com/20260826/4wjUyLSJ/index.m3u8"},{"name":"第05集","url":"https://vod1.maowushi.com/20260827/uqfwF6Kj/index.m3u8"},{"name":"第06集","url":"https://vod1.maowushi.com/20260827/xlSUZHgK/index.m3u8"},{"name":"第07集","url":"https://vod1.maowushi.com/20260828/fARWkjTz/index.m3u8"},{"name":"第08集","url":"https://vod1.maowushi.com/20260828/nGUtqgVh/index.m3u8"},{"name":"第09集","url":"https://vod1.maowushi.com/20260829/7V6fjWjc/index.m3u8"},{"name":"第10集","url":"https://vod1.maowushi.com/20260829/MTSXEoEc/index.m3u8"},{"name":"第11集","url":"https://vod1.maowushi.com/20260830/EkHnGeNX/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"第01集","url":"https://v.lzcdn27.com/share/e8da6d326d9dd901bce129d5bcdfde63"},{"name":"第02集","url":"https://v.lzcdn27.com/share/cf247d6dafc3aadcdf0b2cd608ac8f72"},{"name":"第03集","url":"https://v.lzcdn27.com/share/7f1da4ed0fa4babef8