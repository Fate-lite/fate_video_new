8:["$","div",null,{"className":"w-full flex flex-col gap-8 md:gap-12","children":[["$","$L12",null,{"bannerList":[{"id":"2e0a77d368d293d00d48bb712ed873e7","title":"鲨笼绝境","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260826-1/8765173a58672eba549c7af9b012a257.webp","lang":"英语","area":"西班牙 / 美国","year":"2026","note":"更新TC","actor":"拉米罗·阿隆索 / 安东尼奥·班德拉斯 / 瑞安·伯特罗奇 / 耶斯·利奥丹 / 迭戈·利纳斯 / 路易·曼迪勒 / 劳拉·马兰洛 / 蒂莫西·V·墨菲 / 克里斯蒂娜·奥乔亚 / 罗德里戈·波伊松 / 马里奥·塔东 / 唐查·泰南","director":"杰西·约翰逊","des":"<p>　五位挚友相约前往热带海岛度假，计划在碧蓝海域中体验刺激的鲨鱼笼潜水，同时享受奢靡的派对狂欢。然而他们浑然不知，这趟旅程不过是一场精心布局的犯罪幌子，幕后主谋正是行事冷酷、算无遗策的危险人物“伯恩斯”——他在暴力中淬炼成型，对大海了如指掌。当阴谋突然引爆，一场激烈冲突 让女主角塔蒂亚娜与好友卡莉被困深海之中：头顶是氧气瓶指针飞速下滑的恐慌，四周是游弋不去的鲨鱼，水面之上则是伯恩斯穷凶极恶的手下虎视眈眈。夹在水下猛兽与水面上暴徒的双重绞杀之间，塔蒂亚娜必须凭借全部的智慧与勇气，在生命流逝之前找到逃出生天、拯救同伴的唯一出路。影片将海洋生存惊悚的窒息感与犯罪动作的高燃节奏融于一体，充满意料之外的反转，令人屏息。</p>","last":"2026-08-26 22:20:43","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260826/qYkbRaoR/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"TC","url":"https://b3.bdzybf22.com/videos/202608/01/6a6dad6f0452185f59ab033a/96105e/index.m3u8"}]},{"sourceName":"爱弹幕 (okm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"TC","url":"https://v13.yaaabc.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (kcm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"TC","url":"https://v13.kuaichezym3u8.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (sdm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"TC","url":"https://v13.qqqrst.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (jinyingm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"jinyingm3u8","links":[{"name":"正片","url":"https://hd.ijycnd.com/play/eXD52ole/index.m3u8"}]},{"sourceName":"爱弹幕 (hnm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/dR61Do0d/index.m3u8"}]},{"sourceName":"爱弹幕 (ffm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD中字","url":"https://vip.ffzy-plays.com/20260826/57485_e2e71bde/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.vvvip-plays33.cc/20260826/18575_4c21c9d3/index.m3u8"}]},{"sourceName":"动漫发布 (okm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"TC","url":"https://v13.yaaabc.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"TC","url":"https://v13.kuaichezym3u8.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"动漫发布 (sdm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"TC","url":"https://v13.qqqrst.com/yyv13/202608/01/V5jRF1GUGQ27/video/index.m3u8"}]},{"sourceName":"动漫发布 (jinyingm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"jinyingm3u8","links":[{"name":"正片","url":"https://hd.ijycnd.com/play/eXD52ole/index.m3u8"}]},{"sourceName":"动漫发布 (hnm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/dR61Do0d/index.m3u8"}]},{"sourceName":"动漫发布 (ffm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD中字","url":"https://vip.ffzy-plays.com/20260826/57485_e2e71bde/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.vvvip-plays33.cc/20260826/18575_4c21c9d3/index.m3u8"}]}]},{"id":"cc8d336a8a74976abd9bd4c68a77b9f9","title":"怒之杀","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260826-1/67e70bf6dd7e0c0f497db4c990097b16.webp","lang":"英语","area":"英国 / 美国","year":"2026","note":"更新HD","actor":"杰森·斯坦森 / 安娜贝拉·沃丽丝 / 阿纳斯·费达拉维修斯 / 艾德里安·莱斯特 / 罗兰·默勒 / 钱尼尔·库勒 / 李·查尔斯 / 汤姆·克里斯蒂安 / 杰森·王 / 史蒂文·布拉德斯 / 本·卡特赖特 / 露米·萨顿","director":"让-弗朗索瓦·雷切","des":"<p>　科尔·里德（杰森·斯坦森 饰）是富豪蒂布（阿蒙·蒂卡拉姆 饰）的贴身保镖，但一场意外袭击让蒂布丧命，科尔也被诬陷为凶手，全境通缉。</p><p>　　恩人被杀、自己蒙冤，科尔带着满腔愤怒，只身闯入远洋货轮开启一秒收割一命的硬核复仇，又意外揭开了一个骇人听闻的阴谋……怒火点燃大海，货轮成为血色牢笼，一场避无可避的厮杀即将展开！</p><p><br/></p>","last":"2026-08-26 13:13:03","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260826/oKjnFmeL/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/ebe922af8d4560c73368a88eeac07d16"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260820/9634_671add2a/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/20/6a86f63d0452185f59bb50c7/52e790/index.m3u8"}]},{"sourceName":"爱弹幕 (lzm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260820/9634_671add2a/index.m3u8"}]},{"sourceName":"爱弹幕 (ffm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD中字","url":"https://vip.ffzy-play10.com/20260820/70320_906221c7/index.m3u8"}]},{"sourceName":"爱弹幕 (jinyingm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"jinyingm3u8","links":[{"name"