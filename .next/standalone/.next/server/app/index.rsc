://v.lzcdn27.com/20260916/17039_ecc32b32/index.m3u8"},{"name":"第24集","url":"https://v.lzcdn27.com/20260916/17041_812c29cd/index.m3u8"},{"name":"第25集","url":"https://v.lzcdn27.com/20260917/17112_cfb66b21/index.m3u8"},{"name":"第26集","url":"https://v.lfthirtytwo.com/20260917/10649_b9d50a70/index.m3u8"},{"name":"第27集","url":"https://v.lzcdn27.com/20260918/17194_0973653c/index.m3u8"},{"name":"第28集","url":"https://v.lzcdn27.com/20260918/17198_874c7173/index.m3u8"}]}]},{"id":"9203fa125a53bc12cafc26dfd97f4beb","title":"兰香如故","type":"dianshi","typeName":"国产剧","pic":"https://img.lzipic.com/upload/vod/20260911-1/53d0865f25356e185cf51d6b014635e5.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新至第18集","actor":"谭松韵,刘学义,李梦,郑合惠子,郭柯宇,吴甜甜,叶青,蒲萄,宋芳园,李嘉鑫,刘佳玺,牛骏峰,苏可,侯长荣,陈创,孔令美,魏子昕,吴晓东,严晓频,章申,刘美含,贺鹏,嘉泽,郭迦南,汤梦佳,马凡丁,关畅,赵秦,李泓良,吴天琪,柯蓝,董晴,沈泰,孔连顺,张铎,邬家楷,叶筱玮,马闻远,辛鹏,姚一奇,赵梓冲,辛浩江,王佳璇,王玉宁,孙仲秋,郑卫莉,王艺禅,王亚军,周知,奚望","director":"黄颖湘,陈丹","des":"<p>该剧根据禾晏山小说《兰香缘》改编。                                                                      　　大学士府长孙女沈嘉兰与吏部尚书林家的长孙林锦楼订下婚约，然而朝堂风云突变，祖父沈大学士被判谋逆之罪，沈家惨遭灭门。林家为了自保，与沈家退婚，另与御前新贵赵家结亲。沈嘉兰母亲崔氏曾接济过的林家家奴许万全夫妇用刚病亡的女儿许兰香替下嘉兰。嘉兰从此顶着许 兰香的身份，成为林府的一名三等丫鬟。在艰难的境遇中，兰香没有向命运低头，始终为自己和家人的幸福生活努力着，反抗一切不公与压迫。最终，兰香凭借自己的善良与聪慧，突破阶级身份的束缚，赢得林锦楼倾心的同时也获得了林家上下的信服与尊重，成为林家的当家人，将命运牢牢掌控在自己的手中，为沈家洗刷冤屈讨回公道。</p>","last":"2026-09-18 18:53:36","sources":[{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"第01集","url":"https://v.lzcdn27.com/share/589bc0d3a8cfeace553b6869205e0172"},{"name":"第02集","url":"https://v.lzcdn27.com/share/1e5ae5c4ebcc2cadb8a09909f3731c35"},{"name":"第03集","url":"https://v.lzcdn27.com/share/f1248ade4381b326436757a0b5266088"},{"name":"第04集","url":"https://v.lzcdn27.com/share/b1553ff2787f1055807a8058fe1f8d99"},{"name":"第05集","url":"https://v.lzcdn27.com/share/fe33b4901179d6118f8859c27426e45b"},{"name":"第06集","url":"https://v.lzcdn27.com/share/37d454532975b012c01edbd3bdffdae0"},{"name":"第07集","url":"https://v.lzc