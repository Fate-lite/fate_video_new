urceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"TC","url":"https://v5.qqqrst.com/yyv5/202605/23/HnMrSmBJcL24/video/index.m3u8"}]}]},{"id":"cea7d223f5b078c81e8f09db8f5c1ca2","title":"蝙蝠侠：骑士陨落 第一部：骑士陨落","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260826-1/7b64fed3752ef7bf8a2384f78655e689.webp","lang":"英语","area":"美国 / 韩国","year":"2026","note":"正片","actor":"安松·蒙特 / 巴勃罗·施瑞博尔 / 布鲁斯·巴克林纳 / 巴亚尔多·德·穆古拉 / 杰克·吉芬 / 迈克尔·曼多 / 西蒙·坦普尔曼","director":"杰夫·瓦斯特","des":"<p>　被称为“贝恩”的神秘巨兽只身突破阿卡姆疯人院，将蝙蝠侠的全部宿敌尽数释放到哥谭街头，整座城市瞬间陷入前所未有的犯罪狂潮。蝙蝠侠为了追捕四散的反派，日夜不休地奔波在哥谭的各个角落，精神与体力都被消耗到极限。而这一切，都是贝恩精心策划的棋局——他在暗处冷眼观察，步步紧逼，用连绵不绝的危机一点点消磨披风斗士的意志，一步步将蝙蝠侠推向身心双重崩溃的临界点。</p>","last":"2026-08-26 22:19:36","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260826/p1cwfKvk/index.m3u8"}]}]},{"id":"64928a115c8ea0027a9c1b2fc9b2b35d","title":"祈念守护人","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260826-1/65e49c2b1a01b760e18ea4f4c16bfdc1.webp","lang":"日语","area":"日本","year":"2026","note":"更新HD","actor":"高桥文哉 / 天海祐希 / 斋藤飞鸟 / 宫世琉弥 / 大泽隆夫","director":"伊藤智彦","des":"<p>　直井玲人遭遇不公对待丢掉工作，又因被捕彻底跌入人生谷底。他向命运彻底屈服，失去了主动选择的意志，完全放弃了对未来的期待。就在他任由自己沉沦的时候，一场意料之外的相遇悄然降临，给了他一个足以改写整个人生的机会。</p>","last":"2026-08-26 19:26:35","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260826/8Yg1xa8B/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/83a703361336ec7c6f2efcd4f4a44206"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260817/9545_685c6562/index.m3u8"}]},{"source