e11/index.m3u8"},{"name":"第29集","url":"https://v.lzcdn27.com/20260913/16903_03668cb1/index.m3u8"},{"name":"第30集","url":"https://v.lzcdn27.com/20260914/16943_1bce522d/index.m3u8"},{"name":"第31集","url":"https://v.lzcdn27.com/20260915/17000_5793cc34/index.m3u8"},{"name":"第32集","url":"https://v.lzcdn27.com/20260916/17042_1050e084/index.m3u8"},{"name":"第33集","url":"https://v.lzcdn27.com/20260917/17127_a7f1b90c/index.m3u8"},{"name":"第34集","url":"https://v.lzcdn27.com/20260918/17201_674745a7/index.m3u8"}]}]},{"id":"c06c3f8bc222a950fe57477268dfa7d4","title":"交锋2026","type":"dianshi","typeName":"国产剧","pic":"https://img.lzipic.com/upload/vod/20260906-1/a90d5e8d5cfad104ede6d467120e9b2d.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"更新至第28集","actor":"王凯,周依然,欧豪,彭昱畅,成泰燊,齐欢,邱天,吴启华,吴越,岳旸,高鑫,高捷,祖峰,董勇","director":"姚晓峰","des":"<p>故事由一宗世纪之交的泄密大案而起，扣动两岸局势脉搏的同时，还掩藏着一场境外势力与我方在隐蔽战线上的针锋较量。上世纪九十年代末，闽州市国家安全局一对性格迥异的师徒，因机缘巧合的命运安排，为了共同的使命与信仰并肩作战。他们联手挫败了各种阴谋，也与敌手在横跨二十年的命运长河里不断纠缠。当时间流转，新世纪的潮流剧变席卷而来，国家安全局势攻防易势，隐蔽战线上的较量却不止不休。在一次次关乎人性的考验中，这三人的命运关系因不同抉择，在岁月洗礼中悄然改变着……</p>","last":"2026-09-18 18:53:55","sources":[{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"第01集","url":"https://v.lfthirtytwo.com/share/1a09a1f048354ae7570bf137f30abd21"},{"name":"第02集","url":"https://v.lfthirtytwo.com/share/886ad506e0c115cf590d18ebb6c26561"},{"name":"第03集","url":"https://v.lfthirtytwo.com/share/4c9c3070235a7af934be4e46215c0cbc"},{"name":"第04集","url":"https://v.lfthirtytwo.com/share/a59afb1b7d82ec353921a55c579ee26d"},{"name":"第05集","url":"https://v.lfthirtytwo.com/share/995d8b30b557a46be7d27e26b689ad55"},{"name":"第06集","url":"https://v.lfthirtytwo.com/share/cae7115f44837c806c9b23ed00a1a28a"},{"name":"第07集","url":"https://v.lfthirtytwo.com/share/40f6e633518b32939156a842c93a84be"},{"name":"第08集","url":"https://v.lfthirtytwo.com/share/76c6c66b84436d4dea31e13d1a2d826c"},{"name":"第09集","url":"https://v.lzcdn27.com/share/2330b630a226a3c65689e