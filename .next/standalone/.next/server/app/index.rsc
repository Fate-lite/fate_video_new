8:["$","div",null,{"className":"w-full flex flex-col gap-8 md:gap-12","children":[["$","$L12",null,{"bannerList":[{"id":"618d0763174e98aaebce01ada75ddf8b","title":"关索岭","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260917-1/8655c50a50f3a5ccb2ce83c302604744.jpg","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"张丹峰 / 张傲月 / 陈都灵 / 张明明","director":"余伟国","des":"<p>　丁虎和沈啸飞是八百年前明军的后裔，先后爱上了采茶女金儿。他们生活在宁静的田园中，由于居住的屯堡位于交通要塞，这里成为了日军攻占的重要目标。面对外敌入侵，丁虎和沈啸飞毅摒弃前嫌，民族大义高于个人恩怨。他们以关索岭为中心，带领乡亲们奋勇抵抗，最终全歼了一股携带机密测绘地图的敌人。</p>","last":"2026-09-17 21:15:43","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260917/WvP3sF9S/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/ef2f8301bf2c3404552f1c3df84df9ec"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260918/10661_59e8c46e/index.m3u8"}]},{"sourceName":"爱弹幕 (okm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"HD","url":"https://v15.yaaabc.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.vvvip-plays33.cc/20260917/19752_41734614/index.m3u8"}]},{"sourceName":"爱弹幕 (wjm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v5.ppqrrs.com/wjv5/202609/17/RnyMsKKSpi92/video/index.m3u8"}]},{"sourceName":"爱弹幕 (sdm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"HD","url":"https://v15.qqqrst.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (ffm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://vip.ffzy-play9.com/20260917/49390_e327949a/index.m3u8"}]},{"sourceName":"爱弹幕 (kcm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v15.kuaichezym3u8.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (lzm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260918/10661_59e8c46e/index.m3u8"}]},{"sourceName":"动漫发布 (okm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"HD","url":"https://v15.yaaabc.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.vvvip-plays33.cc/20260917/19752_41734614/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v5.ppqrrs.com/wjv5/202609/17/RnyMsKKSpi92/video/index.m3u8"}]},{"sourceName":"动漫发布 (sdm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"HD","url":"https://v15.qqqrst.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"动漫发布 (ffm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://vip.ffzy-play9.com/20260917/49390_e327949a/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v15.kuaichezym3u8.com/yyv15/202609/17/7Sx1DR7sQN27/video/index.m3u8"}]},{"sourceName":"动漫发布 (lzm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260918/10661_59e8c46e/index.m3u8"}]}]},{"id":"bab768b9d4f63439e53c197e8cf93a86","title":"惩罚者","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260915-1/26d8b192b4ffdada97142e0e93e0a826.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"张亚奇 / 斯力更 / 刘羽琦 / 王潇 / 熊思媛","director":"崔炎龙","des":"<p>南澳，滨海之城，霓虹之下暗流汹涌。热血警察郑译目睹搭档张铭志为掩护自己而死。警局腐败，反将张铭志诬为内鬼。郑译信念崩塌，脱下警服，以暴制暴向毒枭钱九复仇。就在手刃仇敌之际，却发现张铭志并未死去，他早已被钱九收买，假死脱身。曾经的生死兄弟，如今隔着背叛的深渊。毒枭追杀、警局抛弃、爱人惨死，这对反目的兄弟被迫放下恩怨，以残躯为刃向黑暗发起悲壮的反扑，用生命完成了情义的最终救赎，撕开了笼罩南澳的毒网。</p>","last":"2026-09-15 12:20:12","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260915/s9hsEpp2/index.m3u8"}]}]},{"id":"6be6b726cd75ff393d61f8f453b342e2","title":"逃出绝命街","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260914-1/3fffb79395ccdc7c58ae69ec417e7118.webp","lang":"英语","area":"美国 / 加拿大 / 澳大利亚","year":"2026","note":"正片","actor":"安妮·海瑟薇 / 伊万·麦克格雷格 / 梅西·斯黛拉 / 克里斯蒂安·康佛瑞 / 乔丹·亚历山大·戴维斯 / P·J·伯恩 / 哈德森·米克 / 安妮·吉伯德 / 艾米丽·黑田 / 西姆斯·梅 / 格雷森·索恩·基尔帕特里克 / 派雷特·邦奇 / 沃克·拉塞尔 / 雨果·西尔弗 / 迈克尔-克里斯蒂安·摩尔","director":"大卫·罗伯特·米切尔","des":"<p>一场神秘事件，让橡树街从平静郊区穿越回史前时代，导致恐龙突然惊现人类小区，并开始大肆吃人！普拉特一家发现他们只有团结一心奋力一搏，才有希望逃出绝命街，才有可能活下去。</p>","last":"2026-09-14 13:56:48","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260914/Laqshs4Q/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/752eaf975d0a06d11f32a62f37e2101a"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260915/10549_f2c59518/index.m3u8"}]}]},{"id":"f8da63b991a2cf5fcd6c6a82bf3510ff","title":"蜂鸟行动","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260912-1/8f02ec3d62084842f9682b73b3aaf91d.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"谢云鹏 / 克拉拉 / 任贤齐","director":"谢云鹏","des":"<p>　异乡生活的杨东和小汤圆父女在归国途中偶然遭到神秘科技的降维打击。他们在困境中坚持责任与担当。他们依靠和同伴的信任与团结探寻真相并且解除危机完成使命。最终他们重新踏上回国的旅程。</p>","last":"2026-09-12 13:16:52","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260912/f2pAzzsN/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/b0eeffad438fd186126c11fecdceab44"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260912/10448_7739445a/index.m3u8"}]}]},{"id":"f866827db0fe413b733230f81605bc81","title":"无情的拳头","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260910-1/10e7670fc1fb9a6afc8d700a2121203a.webp","lang":"马来语","area":"马来西亚","year":"2026","note":"正片","actor":"Mierul Aiman / 艾迪·阿什拉夫 / 祖尔·阿里芬 / 博朗·帕拉雷 / Amir Ahnaf","director":"Razaisyam Rashid","des":"<p>　在一场格斗比赛中，塔塔无意间导致对手死亡。此后，他发誓再也不参加任何格斗比赛了。然而，当他唯一的妹妹病重需要昂贵的治疗时，一位黑帮头目向他伸出了“经济援助”的橄榄枝，条件是他要在地下世界的职业格斗赛中为他效力。</p>","last":"2026-09-10 12:07:32","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260910/PyXIDbDD/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/ff12592a08c792faa97fd3d2dc40f1cd"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260911/10413_cb797d5e/index.m3u8"}]}]},{"id":"f49d374255a7c6b32152b5448291ff03","title":"热血部落","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260908-1/a1c437bde6d6d6b929dc7f0b1eaf08b2.webp","lang":"汉语普通话","area":"中国大陆","year":"2026","note":"正片","actor":"","director":"倵泉","des":"古代武打 云南秀叭巴电影制作有限公司 网络故事片","last":"2026-09-08 20:01:21","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260908/GOKOYaUO/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/ca751e6ab38280edada823df9cb45a93"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260911/10420_1f474039/index.m3u8"}]}]}]}],"$L13","$L14","$L15","$L16"]}]
