ame":"动漫发布 (jinyingm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"jinyingm3u8","links":[{"name":"正片","url":"https://hd.ijycnd.com/play/dG68Q58b/index.m3u8"}]},{"sourceName":"动漫发布 (ffm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"ffm3u8","links":[{"name":"HD国语","url":"https://super.ffzy-online6.com/20260818/39001_f7afdb11/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v14.kuaichezym3u8.com/yyv14/202608/18/QceWWZKWUJ27/video/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD国语","url":"https://cdn.vvvip-plays33.cc/20260818/17529_4fa87f4a/index.m3u8"}]},{"sourceName":"动漫发布 (lzm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260819/9594_99c748af/index.m3u8"}]}]},{"id":"83f703a72fed6d1c2ecbb97432cdc00c","title":"青年华盛顿","type":"dianying","typeName":"动作片","pic":"https://www.imgzy360.com:7788/upload/vod/20260813-1/2d83c977365b9edd16b178639d5d5b66.webp","lang":"英语","area":"美国","year":"2026","note":"正片","actor":"威尔·约瑟夫 / 本·金斯利 / 玛丽-露易丝·帕克 / 安迪·瑟金斯 / 凯尔塞·格拉玛 / 安格斯·卡斯提·道蒂 / 威廉·弗兰克林-米勒 / 约诺·戴维斯 / 米娅·罗杰斯 / 乔尔·斯马尔本 / 迈克尔·本茨 / John Foss / 伊恩·迪龙 / 莱奥·哈纳 / Eoin Lynch / Jonathan Dow / 阿尔菲·基利 / Nicholas Antoniou / Fearghal Geraghty / Paul Delahunty","director":"乔恩·欧文","des":"<p>年轻的乔治·华盛顿身处战乱频发的北美殖民地，怀着一腔热血投身军营，在边境战场崭露头角。残酷的战火里他直面生死，也遭遇了盟友的背叛与利益的算计，一次次站在关乎立场与生死的十字路口，做出艰难的抉择。在军营、议会与荒野战场的多重淬炼之下，那个出身种植园的青涩青年，一步步褪去莽撞，显露出足以撼动时代的领袖格局。</p>","last":"2026-08-13 13:52:40","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260813/emLq9dw8/index.m3u8"}]}]}]}],"$L13","$L14","$L15","$L16"]}]
