}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"TC中字","url":"https://v.lfthirtytwo.com/share/c5a3c867a3dfb776552dcfc804d4937e"}]},{"sourceName":"爱弹幕 (hnm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"抢先版","url":"https://hn.bfvvs.com/play/dPNQQKya/index.m3u8"}]},{"sourceName":"动漫发布 (hnm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"抢先版","url":"https://hn.bfvvs.com/play/dPNQQKya/index.m3u8"}]}]},{"id":"349d20145d3543b60dca77b7dcead26d","title":"小黄人与大怪兽","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260812-1/dd8cf58a89fedd898e25431e90631a98.webp","lang":"英语 / 德语","area":"美国","year":"2026","note":"更新HD","actor":"皮埃尔·柯芬 / 特雷·帕克 / 克里斯托弗·瓦尔兹 / 艾莉森·珍妮 / 杰西·艾森伯格 / 佐伊·达奇 / 杰夫·布里吉斯 / 鲍比·莫尼汉 / 菲尔·拉马 / 乔治·卢卡斯 / 卡洛斯·阿拉斯拉奇 / 芭芭拉·伊芙·哈里斯 / 艾瑞克·鲍扎 / 亚伦·亨德利 / 卡姆登·布鲁克斯","director":"皮埃尔·柯芬","des":"<p>　为了拍摄心中理想的怪兽电影，小黄人（皮埃尔·柯芬 Pierre Coffin 配音）这群萌趣活宝四处物色演员，竟然真的集齐了各式怪兽，上演疯狂大乱斗！</p>","last":"2026-08-12 16:53:45","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260812/NQeNnLuI/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/65cf25ef90de99d93fa96dc49d0d8b3c"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"TC","url":"https://b3.bdzybf22.com/videos/202606/26/6a3e37f99ed9215f583d58c5/2bc7e4/index.m3u8"},{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/11/6a7b2a556ad3eb5f71fd5e21/0a69f3/index.m3u8"}]},{"sourceName":"爱弹幕 (hnm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/eVO7Pj5a/index.m3u8"}]},{"sourceName":"动漫发布 (hnm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"hnm3u8","links":[{"name":"正片","url":"https://hn.bfvvs.com/play/eVO7Pj5a/index.m3u8"}]}]},{"id":"8b5d796fda6822e98b9d59a8f48b4f4e","title":"我心里危险的东西 剧场版","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260809-1/fde1080f1981aa0d40351e1ab6486341.webp","lang":"日语","area":"日本","year":"2026","note":"正片","actor":"羊宫妃那 / 堀江瞬","director":"陈达理 / 赤城博昭","des":"<p>　市川京太郎是个沉迷于《杀人大百科》和《解剖图鉴》这类书籍、中二病病入膏肓的男生。就在市川沉浸于自己安静的世界时，班上的风云人物·山田杏奈突然闯了进来！她在图书室狼吞虎咽地吃御饭团，或是哼着小曲儿。有时又突然凑得很近……面对山田难以预测的言行，市川虽然困惑不已，却不知不觉间满脑子都是山田的身影了。另一方面，山田也在与市川交谈的过程中，逐渐对他的存在在意起来──。</p><p>　　第一次体会到的“喜欢”这种心情。无论是擦肩而过的误会，还是笨拙的心意，两人都一一跨越，彼此的距离虽然缓慢，却无比坚定地逐渐拉近了。</p><p><br/></p>","last":"2026-08-10 19:03:41","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260809/ashTTMm0/index.m3u8"}]}]}]}]
