16:["$","$L17",null,{"title":"热播动漫","keyName":"dongman","videos":[{"id":"323bb3362604b91768f062a65448e58f","title":"凤仙花2025","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260830-1/a2ae8071394f4c89400a737937b0e1a6.webp","lang":"日语","area":"日本","year":"2025","note":"更新HD","actor":"小林薰 / 户塚纯贵 / 满岛光 / 宫崎美子 / 泷正则","director":"木下麦","des":"<p>　孤独的牢房里，垂暮的老囚虚弱地等待死亡降临。“真是可悲的一生啊！”临终之际，一株凤仙花竟开口说话，唤醒了他深埋心底的过往。一切始于1986年夏天，小屋后院盛开着一片凤仙花。他曾是叱咤风云的黑帮人物，也曾与挚爱共筑片刻美好，却步步走上歧路，徒留来不及说出口的悔恨与遗憾。幸福如花火般闪现，短暂而灿烂。他是否能在生命的最后一刻，翻转命运的棋局？花，是否还能再次绽放？</p>","last":"2026-08-30 12:42:17","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260830/iHFm4aTh/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"HD","url":"https://b3.bdzybf22.com/videos/202608/30/6a93d13d2394fd5f7089313d/61cd03/index.m3u8"}]},{"sourceName":"爱弹幕 (okm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"HD","url":"https://v13.yaaabc.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (wjm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v5.ppqrrs.com/wjv5/202608/30/RAtAwHnbV990/video/index.m3u8"}]},{"sourceName":"爱弹幕 (sdm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"HD","url":"https://v13.qqqrst.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]},{"sourceName":"爱弹幕 (kcm3u8)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v13.kuaichezym3u8.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]},{"sourceName":"动漫发布 (okm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"okm3u8","links":[{"name":"HD","url":"https://v13.yaaabc.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]},{"sourceName":"动漫发布 (wjm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"wjm3u8","links":[{"name":"HD","url":"https://v5.ppqrrs.com/wjv5/202608/30/RAtAwHnbV990/video/index.m3u8"}]},{"sourceName":"动漫发布 (sdm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"sdm3u8","links":[{"name":"HD","url":"https://v13.qqqrst.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]},{"sourceName":"动漫发布 (kcm3u8)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"kcm3u8","links":[{"name":"HD","url":"https://v13.kuaichezym3u8.com/yyv13/202608/30/DPyfcNtUwH27/video/index.m3u8"}]}]},{"id":"40d2c5d3489f248539c2c0c70ea05585","title":"银魂 吉原大炎上","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260828-1/923a11da3ce5ffb8654d6365d4ab2375.webp","lang":"日语","area":"日本","year":"2026","note":"更新TC","actor":"杉田智和 / 阪口大助 / 钉宫理惠","director":"安藤尚也","des":"<p>　原作史上最炽热璀璨的经典篇章——“吉原炎上篇”，将以完全新作之姿登陆大银幕。</p>","last":"2026-08-28 19:51:12","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260828/IpkxZxpl/index.m3u8"}]},{"sourceName":"百度资源 (dbm3u8)","sourceUrl":"http://api.apibdzy.com/api.php/provide/vod/","from":"dbm3u8","links":[{"name":"TC","url":"https://b3.bdzybf22.com/videos/202606/14/6a2e8b092394fd5f70443045/143c84/index.m3u8"}]}]},{"id":"e01b667630074d25dd6805f3e596364a","title":"侠盗猎车手6：加长版深度实机赏析","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260828-1/8d0b9a03e8abc276ab2594fa21b88bc4.webp","lang":"英语","area":"美国","year":"2026","note":"HD中字","actor":"","director":"","des":"<p>　Grand Theft Auto VI: An Extended Look will premiere on Netflix Thursday, August 27 at 3 p.m. ET and will also launch on the official Rockstar Games YouTube channel and the Grand Theft Auto VI site at 9 p.m. ET on August 27.</p>","last":"2026-08-28 12:57:43","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260828/hRNYsjlo/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.vvvip-plays33.cc/20260828/18669_91cbfe32/index.m3u8"}]},{"sourceName":"动漫发布 (1080zyk)","sourceUrl":"http://ddmf.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.vvvip-plays33.cc/20260828/18669_91cbfe32/index.m3u8"}]}]},{"id":"56b5ca912b078250e8e9e691ad3dd270","title":"哆啦A梦：新·大雄的海底鬼岩城","type":"dongman","typeName":"动画片","pic":"https://www.imgzy360.com:7788/upload/vod/20260827-1/18bc7c69d68b852a72264f82adcfd3de.webp","lang":"日语","area":"日本","year":"2026","note":"HD中字","actor":"水田山葵 / 大原惠美 / 嘉数由美 / 木村昴 / 关智一 / 千叶翔也 / 广桥凉 / 平爱梨 / 平子祐希 / 酒井健太","director":"矢岛哲生","des":"<p>　大雄他们打算在暑假一起露营，不过各人心目中的地点都不一样，最后哆啦A梦竟然建议到海底露营？大家靠着哆啦A梦的法宝“水底旅行车”和“万应灯”，愉快地在海洋深处冒险。他们更发现原来海底有个庞大的国家“姆联邦”，并遇见“海底人”的少年希路。与此同时，海底人最惧怕的“鬼岩城”正蠢蠢欲动，更有可能令地球灭亡？</p><p>　　本片是1983年《大雄的海底鬼岩城》的重制版。</p><p><br/></p>","last":"2026-08-27 18:53:00","sources":[{"sourceName":"360资源 (360zy)","sourceUrl":"https://360zy.com/api.php/provide/vod/","from":"360zy","links":[{"name":"正片","url":"https://vod1.maowushi.com/20260827/UMknnVBs/index.m3u8"}]},{"sourceName":"量子资源 (liangzi)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"liangzi","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/share/373cb8cd58cad5f1309b31c56e2d5a83"}]},{"sourceName":"量子资源 (lzm3u8)","sourceUrl":"https://cj.lziapi.com/api.php/provide/vod/","from":"lzm3u8","links":[{"name":"HD中字","url":"https://v.lfthirtytwo.com/20260827/9819_9276d926/index.m3u8"}]},{"sourceName":"爱弹幕 (1080zyk)","sourceUrl":"http://www.lovedan.net/api.php/provide/vod/","from":"1080zyk","links":[{"name":"HD中字","url":"https://cdn.yzzy31-play.com/20260826/24699_c44953f2/index.m3u8"}]},{"sourceName":"爱弹幕 (ffm3u8)","sou