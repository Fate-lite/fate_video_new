generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-cache"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model cache {
  cache_key  String @id
  data       String
  created_at Int
  expire_at  Int
}

model search_history {
  keyword    String @id
  count      Int
  updated_at Int
}

model source_status {
  api_url    String @id
  is_online  Int
  latency    Int
  updated_at Int
}
